{
  "name": "coproguide",
  "version": "0.1.0",
  "private": true,
  "description": "RAG assistant for French copropriété & tenancy law, with cited articles, a confidence gate and an evaluation harness.",
  "license": "MIT",
  "author": "Slimane Berrada",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest.ts",
    "eval": "tsx scripts/eval.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "fetch:legifrance": "tsx scripts/fetch-legifrance.ts",
    "warm-model": "tsx scripts/warm-model.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@huggingface/transformers": "4.3.1",
    "drizzle-orm": "0.45.4",
    "graphql": "16.14.2",
    "graphql-yoga": "5.24.4",
    "gray-matter": "4.0.3",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
