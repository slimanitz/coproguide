# ---- Database (PostgreSQL 16 + pgvector, see docker-compose.yml) ----
# Host access to the compose database (port 5438). Inside compose the web service overrides it with db:5432.
# docker compose reads this file as defaults and an optional .env on top of it.
DATABASE_URL=postgres://coproguide:coproguide@localhost:5438/coproguide
# Optional: integration tests default to the "coproguide_test" database next to DATABASE_URL.
# TEST_DATABASE_URL=postgres://coproguide:coproguide@localhost:5438/coproguide_test

# ---- LLM provider ----
# "mock" (default): deterministic offline answers, no key needed.
# "openai": OpenAI Chat Completions API (default real provider). "anthropic": Claude API (alternative).
LLM_PROVIDER=mock

# -- OpenAI (LLM_PROVIDER=openai) --
# Required only with LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Azure OpenAI, a local gateway...). Default: api.openai.com.
# OPENAI_BASE_URL=
# Generation model and LLM-as-judge model. Prices for the dashboard live in src/lib/cost.ts.
OPENAI_MODEL=gpt-5
OPENAI_JUDGE_MODEL=gpt-5-mini
# Reasoning effort for generation, sent to GPT-5 / o-series models only: minimal | low | medium | high.
OPENAI_REASONING_EFFORT=low

# -- Anthropic (LLM_PROVIDER=anthropic, alternative) --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_JUDGE_MODEL=claude-haiku-5-5
# Effort for generation: low | medium | high | xhigh | max.
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (fallbacks: "default"). Set to "off" on platforms that reject it.
ANTHROPIC_FALLBACKS=default

# Max output tokens per answer (includes reasoning/thinking tokens), all providers.
LLM_MAX_TOKENS=16000
# Previous question/answer exchanges sent to the model as conversation history.
CHAT_HISTORY_TURNS=10
# Simulated streaming delay of the mock provider, in ms per word.
MOCK_STREAM_DELAY_MS=15

# ---- Evaluation API guard (GraphQL runEval mutation / "Lancer une évaluation" button) ----
# With a paid provider (openai, anthropic), runs cost money: the API refuses to start one unless ADMIN_TOKEN is
# set here AND sent by the caller in the x-admin-token header. Ignored with the mock provider.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=
# At most this many runs started through the API per hour (per server process). Only one run
# can be in progress at a time. `pnpm eval` (CLI) is not subject to these limits.
EVAL_RATE_LIMIT_PER_HOUR=3

# ---- Retrieval ----
# Confidence gate: refuse when the best cosine similarity is below this value.
# Calibrated on the golden set with `pnpm calibrate` (see docs/plan.md, "Calibration").
RAG_MIN_SIMILARITY=0.83
RAG_TOP_K=8

# ---- Embeddings (local, CPU) ----
# ONNX conversion of intfloat/multilingual-e5-small; q8 = int8 quantised (130 MB), fp32 also available.
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DTYPE=q8
MODEL_CACHE_DIR=.cache/models
# Chunking budget in e5 tokens (e5-small truncates inputs at 512 tokens).
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=100

# ---- Costs ----
# Prices are in USD (src/lib/cost.ts); stored costs are converted to euros with this rate.
USD_TO_EUR=0.86

# ---- Légifrance (optional, scripts/fetch-legifrance.ts) ----
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
# sandbox | production
PISTE_ENV=production

# ---- Container ----
# Run migrations + idempotent ingestion when the web container starts.
INGEST_ON_START=true
# Expose GraphiQL in production builds (always on in development).
GRAPHIQL=false
